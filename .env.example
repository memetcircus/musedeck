# MuseDeck Bridge Configuration
PORT=3456
WS_PORT=3457

# Meta Model API Credentials & Configuration
# Obtain your API Key from the Meta Global AI Developer Hackathon portal
META_MODEL_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1

# Meta Model Names
SAM_MODEL_NAME=sam-3.1
SPARK_MODEL_NAME=muse-spark

# Muse Code CLI Configuration
MUSE_CODE_BIN=muse-code
# Set to true to simulate Muse Code execution and HITL gates if the CLI binary is not present
MUSE_CODE_SIMULATION=true
# Process execution timeout in milliseconds (e.g. 180000 = 3 minutes)
CLI_TIMEOUT_MS=180000

# Stream Deck Telemetry UI
STREAMDECK_PORT=3456
WS_URL=ws://127.0.0.1:3457
